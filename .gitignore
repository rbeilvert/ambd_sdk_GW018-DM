# ---------------------------------------------------------------------------
# Artefacts produced by `make all` in project_lp / project_hp.
# None of this is source: every entry below is regenerated by a build.
# ---------------------------------------------------------------------------

# Compiler intermediates. The build drops these both inside asdk/make/ and
# alongside the sources under component/, so they are matched globally.
# Verified safe against this tree: it tracks no .o/.d/.su/.i files.
*.o
*.d
*.su
*.i

# Generated assembly listings. Deliberately scoped rather than global --
# the SDK tracks 19 hand-written .s sources elsewhere.
project/*/GCC-RELEASE/project_*/asdk/make/**/*.s

# Object tree, and the padded/prepended images plus the final .bin set
project/*/GCC-RELEASE/project_*/asdk/build/
project/*/GCC-RELEASE/project_*/asdk/image/

# Build stamp headers, rewritten on every build
project/*/inc/inc_hp/build_info.h
project/*/inc/inc_lp/build_info.h

# The toolchain unpacks itself here on the first build. The split archives
# in project_hp/toolchain/asdk/*.tar.bz2a|b|c ARE source and stay tracked;
# the concatenated archive and the extracted tree are not.
project/*/GCC-RELEASE/project_*/toolchain/linux/
project/*/GCC-RELEASE/project_*/toolchain/cygwin/
project/*/GCC-RELEASE/project_*/toolchain/darwin/
project/*/GCC-RELEASE/project_*/toolchain/asdk/*.tar.bz2

# Editor / OS noise
*.swp
*~
.DS_Store
